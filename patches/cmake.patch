diff --git i/variables.cmake w/variables.cmake
index 0adc703..a155fe8 100644
--- i/variables.cmake
+++ w/variables.cmake
@@ -41,6 +41,15 @@ cmake_dependent_option(DESKTOP_APP_RELEASE_QT "Link the optimized Qt build even
