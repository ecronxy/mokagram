 cmake_dependent_option(DESKTOP_APP_ENABLE_LTO "Enable Link Time Optimization (slow builds, use for releases)." OFF DESKTOP_APP_SPECIAL_TARGET OFF)
+# mokaGram: LTO для release включён и в сборках без special target. Для отладки: -DMOKA_LTO=OFF.
+option(MOKA_LTO "Enable Link Time Optimization in release configurations." ON)
+if (MOKA_LTO OR (DESKTOP_APP_SPECIAL_TARGET AND DESKTOP_APP_ENABLE_LTO))
+    set(MOKA_ENABLE_LTO ON)
+else()
+    set(MOKA_ENABLE_LTO OFF)
+endif()
+# mokaGram: x86-64-v2 (SSE4.2, POPCNT) для 64-битных линукс-билдов. Отключить: -DMOKA_X86_64_V2=OFF.
+option(MOKA_X86_64_V2 "Compile for the x86-64-v2 baseline on Linux." ON)
